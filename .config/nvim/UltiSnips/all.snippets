#call UltiSnips#RefreshSnippets()

snippet (( "() parenthesis enclosure" iA
(${VISUAL}$1)$2$0
endsnippet

snippet [[ "[] parenthesis enclosure" iA
[${VISUAL}$1]$2$0
endsnippet

snippet {{ "{} parenthesis enclosure" iA
{${VISUAL}$1}$2$0
endsnippet

#snippet < "<> parenthesis enclosure" iA
#<${VISUAL}$1>$2$0
#endsnippet

snippet '' "single quotes parenthesis enclosure" iA
'${VISUAL}$1'$2$0
endsnippet

snippet "" "quotes parenthesis enclosure" iA
"${VISUAL}$1"$2$0
endsnippet

